  "blocked_titles": ["登录", "登入", "登陆", "密码", "口令", "验证码", "账户", "账号", "用户名", "凭据", "login", "log in", "sign in", "signin", "password", "credential", "authentication", "1password", "bitwarden", "keepass"]
