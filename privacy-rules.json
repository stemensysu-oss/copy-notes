{
  "version": 1,
  "max_bytes": 200000,
  "min_characters": 24,
  "patterns": [
    "用户名|用戶名|账号|帐号|賬號|账户|密码|密碼|口令|验证码|驗證碼|助记词|私钥|密钥",
    "\\b(user[ _-]?name|password|passwd|pwd|passphrase|secret|token|api[ _-]?key|authorization|bearer|cookie|otp|credential|recovery[ _-]?code|seed[ _-]?phrase)\\b",
    "\\b(user|login|account|pass|pin)\\s*[:=：]",
